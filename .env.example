# =============================================================================
# FunBet Casino - Environnement de Configuration
# =============================================================================
# Copiez ce fichier en `.env` et remplissez les valeurs appropriées.
# En développement, utilise SQLite (aucune configuration supplémentaire).
# En production, configurez PostgreSQL ci-dessous.

# --- Application ---
NODE_ENV="development"                      # "development" | "production"
PORT=3000
APP_URL="http://localhost:5173"             # URL frontend (pour CORS whitelist)

# --- JWT (Authentication) ---
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_STRING_IN_PROD"   # MIN 32 chars
JWT_ACCESS_EXPIRES_IN="15m"                 # Access token TTL
JWT_REFRESH_EXPIRES_IN="30d"               # Refresh token TTL

# --- Base de données ---
# Development: SQLite (fichier local)
DATABASE_URL="sqlite://db/development.db"

# Production: PostgreSQL
# DATABASE_URL="postgresql://user:password@localhost:5432/funbet?sslmode=require"

# --- Sécurité ---
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"  # Whitelist CORS
RATE_LIMIT_AUTH_MAX=5                       # Tentatives login/register par IP
RATE_LIMIT_API_MAX=100                      # Requêtes API par minute par IP
RATE_LIMIT_FINANCIAL_MAX=10                 # Opérations financières par minute/user
RATE_LIMIT_GAME_MAX=60                      # Actions de jeu par minute/user

# --- Bcrypt ---
BCRYPT_ROUNDS=12                            # Coût de hashage (min 10, recommandé 12)

# --- Paiement (optionnel - pour intégration API réelle) ---
MTN_API_KEY=""
MTN_API_SECRET=""
MTN_API_URL="https://api.mtn.com"
ORANGE_API_KEY=""
ORANGE_API_URL="https://api.orange.com"

# =============================================================================
# Variables d'environnement spécifiques Vercel (définir dans le dashboard Vercel)
# =============================================================================
# Ces variables sont automatiquement définies par Vercel lors du déploiement.
# NE PAS les inclure dans .env.local — utilisez le dashboard Vercel → Settings → Environment Variables
#
# NODE_ENV=production            # Vercel définit automatiquement
# VERCEL=1                       # Vercel définit automatiquement (déclenche le mode serverless)
# VERCEL_URL=<votre-domaine>.vercel.app  # URL déployée
#
# Pour le déploiement Vercel, configurez ces variables dans le dashboard:
# - NODE_ENV = "production"
# - JWT_SECRET = <votre-secret-production-plus-long>
# - DATABASE_URL = <url-postgresql-production>
# - CORS_ORIGINS = <votre-domaine-vercel>
# - BCRYPT_ROUNDS = 12
# - Toutes les autres variables ci-dessus (production)

