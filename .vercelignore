# --- Local state & data ---
data/
.env
.env.local

# --- Documentation ---
docs/
*.md
!README.md
!VERCEL.md

# --- Backend Python (non déployé sur Vercel) ---
backend/

# --- Editor / OS files ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Cache & temporaire ---
.cache/
.eslintcache
.vitest/
.nyc_output/
